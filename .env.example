# ---------------------------------------------------------------------------
# Copy to .env and edit. Everything here has a working default except the
# authorization server, where you pick exactly one of the three options below.
# ---------------------------------------------------------------------------

# --- Where this MCP server is reachable ------------------------------------
# Must be the public URL, including the /mcp path. It doubles as the OAuth
# "resource" identifier and as the audience tokens are checked against.
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_SERVER_NAME=Notes MCP
HOST=127.0.0.1
PORT=8000

# --- Storage ---------------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite (./notes.db). Set it to use Postgres
# and install the extra:  uv pip install -e ".[postgres]"
# DATABASE_URL=postgresql://user:pass@localhost:5432/notes
# SQLITE_PATH=./notes.db

# ---------------------------------------------------------------------------
# Authorization server - choose ONE
# ---------------------------------------------------------------------------

# Option A: Descope Agentic Identity Hub (hosted login, consent, DCR).
# Paste the well-known URL shown after you create an MCP server / inbound app.
# DESCOPE_CONFIG_URL=https://api.descope.com/v1/apps/P.../.well-known/openid-configuration

# Option B: any other OIDC / OAuth 2.1 provider. Give the bare issuer; a full
# discovery URL is also accepted and normalised.
# OAUTH_ISSUER=https://your-tenant.us.auth0.com
# OAUTH_AUDIENCE=http://localhost:8000/mcp

# Option C: the bundled dev authorization server - zero setup, local only.
#   terminal 1:  uv run notes_mcp/dev_auth_server.py
#   terminal 2:  uv run notes_mcp/v3_oauth.py
ALLOW_DEV_AUTH=true
DEV_AUTH_URL=http://127.0.0.1:9000

# --- Token validation knobs ------------------------------------------------
# Scopes this server understands and advertises during consent.
MCP_SCOPES=notes:read,notes:write
# Audience checking prevents a token minted for another server being replayed
# here (the "confused deputy" problem). Only disable while debugging.
OAUTH_VERIFY_AUDIENCE=true
